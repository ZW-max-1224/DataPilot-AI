# Copy to .env and fill only when enabling a real LLM provider.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_TIMEOUT=30
LLM_MAX_TOKENS=1024
# Transport retries delegated to the OpenAI SDK (timeouts, 429 and 5xx, with backoff).
LLM_MAX_RETRIES=2

# LangSmith tracing is optional and disabled by default.
# The new LANGSMITH_* names are preferred; the LANGCHAIN_* names are still read.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=datapilot-ai
LANGSMITH_ENDPOINT=
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=datapilot-ai
LANGCHAIN_ENDPOINT=

# Optional MySQL persistence; leave MYSQL_USER blank to disable database access.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=datapilot
MYSQL_USER=
MYSQL_PASSWORD=

# Optional independent Embedding API. Leave disabled unless the provider supports embeddings.
EMBEDDING_PROVIDER=disabled
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_TIMEOUT=20
EMBEDDING_DIMENSIONS=1024

# Local persistent Qdrant storage (ignored by Git).
QDRANT_PATH=data/qdrant
QDRANT_COLLECTION=datapilot_knowledge
